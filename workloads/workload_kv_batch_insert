# YCSB-cpp Application Workload: Batch Insert Stress
# Real-world pattern:
#   - Event buffering and flush
#   - Write-heavy append flows
#
# Insert/update/read ratio: 80/15/5
# Request distribution: uniform

recordcount=1000000
operationcount=1000000
workload=com.yahoo.ycsb.workloads.CoreWorkload

readallfields=true

readproportion=0.05
updateproportion=0.15
scanproportion=0
insertproportion=0.80
readmodifywriteproportion=0

requestdistribution=uniform
insertorder=hashed
hashalgo=sha256
batch_size=64
