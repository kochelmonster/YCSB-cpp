# YCSB-cpp Application Workload: Session Store / Mutable User State
# Real-world pattern:
#   - Web session storage
#   - User state and preferences
#   - Per-user mutable activity records
#
# Read/update ratio: 50/50
# Request distribution: zipfian

recordcount=5000000
operationcount=5000000
workload=com.yahoo.ycsb.workloads.CoreWorkload

readallfields=true

readproportion=0.50
updateproportion=0.50
scanproportion=0
insertproportion=0
readmodifywriteproportion=0

requestdistribution=zipfian
insertorder=hashed
hashalgo=sha256

# Batching and binary keys for maximum throughput
leaves.batch_size=64
lmdb.batch_size=64
leveldb.batch_size=64
rocksdb.batch_size=64

# RocksDB / LevelDB: increase block cache to cover the full 1M-record dataset (~1GB).
# Default 512MB gives ~50% hit rate; 1GB captures the entire working set.
rocksdb.cache_size=1073741824
leveldb.cache_size=1073741824

# WiredTiger: switch from LSM to BTree.
# 50/50 read/update with zipfian — BTree in-place updates avoid LSM write
# amplification, and point reads need no bloom-filter fan-out across levels.
# Clear all LSM config properties (empty value → !empty() guard skips them).
wiredtiger.blk_mgr.bloom_bit_count=
wiredtiger.blk_mgr.bloom_hash_count=
wiredtiger.blk_mgr.chunk_max=
wiredtiger.blk_mgr.chunk_size=
wiredtiger.lsm_mgr.merge=
wiredtiger.lsm_mgr.max_workers=
