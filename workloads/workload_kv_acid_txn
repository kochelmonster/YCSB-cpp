# YCSB-cpp Application Workload: Explicit Multi-Key Transaction Mix
# Each batch groups multiple operations inside a database transaction.
# With batch_size=2 and 50/50 read/update, each transaction typically
# performs one read and one update, exercising multi-key ACID semantics.
# The operation count represents individual operations (half as many transactions).

recordcount=1000000
operationcount=10000
workload=com.yahoo.ycsb.workloads.CoreWorkload

readallfields=true
writeallfields=false

readproportion=0.50
updateproportion=0.50
scanproportion=0
insertproportion=0
readmodifywriteproportion=0

batch_size=2
requestdistribution=zipfian
insertorder=hashed
hashalgo=sha256
