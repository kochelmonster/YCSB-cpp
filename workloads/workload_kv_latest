# YCSB-cpp Application Workload: Recency-Biased Feed / Timeline
# Real-world pattern:
#   - Recent activity feed
#   - Latest-item stream processing
#   - Time-ordered event browsing
#
# Read/update/insert ratio: 95/0/5
# Request distribution: latest

recordcount=1000000
operationcount=1000000
workload=com.yahoo.ycsb.workloads.CoreWorkload

readallfields=true

readproportion=0.95
updateproportion=0
scanproportion=0
insertproportion=0.05
readmodifywriteproportion=0

requestdistribution=latest

# RocksDB / LevelDB: increase block cache to cover the full 1M-record dataset (~1GB).
# Default 512MB gives ~50% hit rate; 1GB captures the entire working set,
# which matters especially for the latest distribution (hot at the high-key end).
rocksdb.cache_size=1073741824
leveldb.cache_size=1073741824

# WiredTiger: switch from LSM to BTree.
# 95% reads with latest distribution (recent inserts are hot) — BTree keeps
# all data in a single ordered structure with no read amplification across levels.
# Clear all LSM config properties (empty value → !empty() guard skips them).
wiredtiger.blk_mgr.bloom_bit_count=
wiredtiger.blk_mgr.bloom_hash_count=
wiredtiger.blk_mgr.chunk_max=
wiredtiger.blk_mgr.chunk_size=
wiredtiger.lsm_mgr.merge=
wiredtiger.lsm_mgr.max_workers=
