    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug YCSB - Leaves Workload A (Load)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/ycsb",
            "args": [
                "-db",
                "leaves",
                "-P",
                "leaves/leaves.properties",
                "-P",
                "workloads/workloada",
                "-load",
                "-s"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug YCSB - Leaves Write Workload (Run)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/ycsb",
            "args": [
                "-load",
                "-db",
                "leaves",
                "-P",
                "leaves/leaves.properties",
                "-P",
                "workloads/workload_kv_concurrent_write",
                "-threads",
                "1",
                "-p",
                "leaves.format=single",
                "-p",
                "leaves.batch_size=64",
                "-p",
                "leaves.destroy=true",
                "-p",
                "recordcount=500000",
                "-s"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
